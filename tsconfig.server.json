{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/domain/**/*.ts",
    "src/online/authorization.ts",
    "src/online/protocol.ts"
  ],
  "exclude": ["src/test/**/*"]
}
